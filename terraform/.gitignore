# Local .terraform directories
**/.terraform/*

# .tfstate files (CRITICAL: These often contain secrets and must not be committed)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .tfvars files (These often contain sensitive credentials or environment-specific data)
*.tfvars
*.tfvars.json

# Ignore override files (Used for local testing, should not be checked in)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
.terraform.lock.hcl