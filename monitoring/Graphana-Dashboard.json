        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (job, status_code) (rate(shopkart_http_errors_total[5m]))",
          "legendFormat": "{{job}} - {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
